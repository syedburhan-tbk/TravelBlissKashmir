rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    // --- WORKSPACE RBAC HELPERS ---
    
    function getWorkspaceMember(workspaceId, userId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId));
    }
    
    function getWorkspaceMemberAfter(workspaceId, userId) {
      return getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(userId));
    }
    
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && getWorkspaceMember(workspaceId, request.auth.uid).data.status == 'ACTIVE';
    }

    function getWorkspaceRole(workspaceId) {
      return getWorkspaceMember(workspaceId, request.auth.uid).data.role;
    }

    function hasWorkspaceRole(workspaceId, allowedRoles) {
      return isWorkspaceMember(workspaceId) && (getWorkspaceRole(workspaceId) in allowedRoles);
    }
    
    function isWorkspaceAdmin(workspaceId) {
      return hasWorkspaceRole(workspaceId, ['SUPER_ADMIN', 'ADMIN']);
    }

    // --- COLLECTIONS ---
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && (memberId == request.auth.uid || resource.data.email == request.auth.token.email);
    }

    match /mail/{mailId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false; // System only
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users shouldn't be listed globally
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid && incoming().keys().hasAll(['uid', 'email', 'name', 'createdAt']);
      allow update: if isOwner(userId); // Simplified update for now
    }

    match /workspaces/{workspaceId} {
      allow get: if isWorkspaceMember(workspaceId);
      allow list: if false; // Must query specifically by known ID
      
      // Only system/admins or new bootstrap could create
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isWorkspaceAdmin(workspaceId);
      allow delete: if hasWorkspaceRole(workspaceId, ['SUPER_ADMIN']);
      
      match /members/{memberId} {
        allow get: if isWorkspaceMember(workspaceId) || memberId == request.auth.uid || (
          memberId == 'pending_' + request.auth.token.email
        );
        allow list: if isWorkspaceMember(workspaceId) || memberId == request.auth.uid;
        
        // Only workspace admins can manage members, OR it's a bootstrap creation, OR accepting invite
        allow create: if isWorkspaceAdmin(workspaceId) || (
          memberId == request.auth.uid && incoming().role == 'SUPER_ADMIN'
        ) || (
          memberId == request.auth.uid && incoming().email == request.auth.token.email
        );
        
        allow update: if isWorkspaceAdmin(workspaceId);
        
        allow delete: if isWorkspaceAdmin(workspaceId) || (
          memberId == 'pending_' + request.auth.token.email && existing().email == request.auth.token.email
        );
      }
      
      match /trips/{tripId} {
        allow get: if true; // Public retrieval for shared links; could restrict to member or public flag.
        // List: requires being a member
        allow list: if isWorkspaceMember(workspaceId);
        
        // Writes: Workspace members with correct roles
        allow create: if hasWorkspaceRole(workspaceId, ['SUPER_ADMIN', 'ADMIN', 'SALES_EXECUTIVE']) 
          && incoming().workspaceId == workspaceId;
          
        allow update: if hasWorkspaceRole(workspaceId, ['SUPER_ADMIN', 'ADMIN', 'SALES_EXECUTIVE', 'OPERATIONS_STAFF']);
        
        allow delete: if hasWorkspaceRole(workspaceId, ['SUPER_ADMIN', 'ADMIN', 'SALES_EXECUTIVE']);
      }
      
      match /activity_logs/{logId} {
        allow get, list: if isWorkspaceAdmin(workspaceId);
        // Anyone in workspace can write a log
        allow create: if isWorkspaceMember(workspaceId) && incoming().userId == request.auth.uid;
        allow update, delete: if false; // Immutable logs
      }
    }
    
    // Legacy support for migrations, can be removed eventually
    match /trips/{tripId} {
        allow get: if true;
        allow list: if true;
        allow write: if true;
    }
  }
}
